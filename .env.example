# Copy to .env and fill keys. Never commit .env.
# LLM backbone: AiCredits only.
AiCredits_Base_Url=https://aicredits.in/v1
Aicredits_API_Key=sk-your-aicredits-key-here
AiCredits_Model=meta/muse-spark-1.3-contributor
# Legacy fallback names (used only if the AiCredits vars above are unset):
# LLM_BASE_URL=https://aicredits.in/v1
# LLM_API_KEY=...
# LLM_MODEL=meta/muse-spark-1.3-contributor

# Jev System-One gate: OpenRouter only (no BeatAI/systemone fallback).
OpenRouterJevBaseUrl=https://openrouter.ai/api/v1
OpenRouterJevAPIKey=sk-or-...
OpenRouterJevModel=typesafe/jev-1.14
# Derived from OpenRouterJevBaseUrl by default:
# OpenRouterJevDecisionsUrl=https://openrouter.ai/api/alpha/decisions
JEV_THRESHOLD=0.6
# JEV_MIN_INTERVAL_S=0

LLM_TEMPERATURE_DIALOGUE=0.3
LLM_TEMPERATURE_JSON=0.0
LLM_MAX_TOKENS=2500
TAU_DELAY=0.35
EVT_THRESHOLD=0.6
