# Copy to .env and fill keys. Never commit .env.
# Current primary LLM: OpenRouter (wins when both vars below are set)
OpenRouterAPIKey=sk-or-...
OpenRouterModel=minimax/minimax-m3.1-flash:free
# OpenRouterBaseUrl=https://openrouter.ai/api/v1
# Fallback LLM: meta/muse-spark-1.3-contributor via AiCredits (used only if OpenRouter vars absent)
LLM_BASE_URL=https://api.aicredits.in/v1
LLM_API_KEY=sk-your-aicredits-key-here
LLM_MODEL=meta/muse-spark-1.3-contributor
# Jev gate: key precedence OpenRouterJevAPIKey > JEV_API_KEY > LLM_API_KEY.
# Unlimited OpenRouter key removes the old ~1 req/min guard (JEV_MIN_INTERVAL_S=0).
OpenRouterJevAPIKey=sk-or-...
# OpenRouterJevBaseUrl=https://openrouter.ai/api/v1
# OpenRouterJevModel=jev-1.13-free
# JEV_MIN_INTERVAL_S=0
# JEV_THRESHOLD=0.6
JEV_BASE_URL=https://api.beatapi.io/v1/systemone
JEV_API_KEY=sk-your-beatai-key-here
JEV_MODEL=jev-1.13-free

LLM_TEMPERATURE_DIALOGUE=0.3
LLM_TEMPERATURE_JSON=0.0
LLM_MAX_TOKENS=1500
TAU_DELAY=0.65
EVT_THRESHOLD=0.6
